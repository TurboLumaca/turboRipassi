# Copia questo file in ".env" e inserisci i valori del tuo progetto.
# Il prefisso EXPO_PUBLIC_ è obbligatorio: rende le variabili leggibili a runtime dall'app.

# --- Supabase (Dashboard Supabase → Project Settings → API) ---
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...la-tua-anon-key...

# --- Google Drive OAuth (Google Cloud Console → APIs & Services → Credentials) ---
# Crea un OAuth client ID per ogni piattaforma (tipo "iOS" e "Android"); in
# mancanza dei client specifici viene usato EXPO_PUBLIC_GOOGLE_CLIENT_ID.
# Abilita la "Google Drive API" nello stesso progetto Google Cloud.
# Redirect URI da registrare: ripassa://drive-auth  (scheme dell'app).
EXPO_PUBLIC_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=xxxxxxxx-ios.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=xxxxxxxx-android.apps.googleusercontent.com

# --- Sentry (crash reporting) — https://sentry.io → Project → Settings → Client Keys (DSN) ---
# Facoltativo in sviluppo: senza DSN il crash reporting è disattivato e l'app
# funziona lo stesso. In produzione, registra questo valore anche su EAS
# (eas env:create --name EXPO_PUBLIC_SENTRY_DSN ...).
EXPO_PUBLIC_SENTRY_DSN=https://xxxxxxxx@oxxxxxxx.ingest.sentry.io/xxxxxxx
