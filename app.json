{
  "expo": {
    "name": "Ripassa",
    "slug": "ripassa",
    "scheme": [
      "ripassa",
      "com.turbolumaca.turboripassi",
      "com.turboLumaca.turboRipassi"
    ],
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "experiments": {
      "reactCompiler": true
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.turboLumaca.turboRipassi",
      "infoPlist": {
        "NSCameraUsageDescription": "Ripassa usa la fotocamera per allegare foto ai ripassi.",
        "NSPhotoLibraryUsageDescription": "Ripassa accede alla galleria per allegare immagini ai ripassi.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.turboLumaca.turboRipassi",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-image-picker",
      "expo-document-picker",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1E3A8A",
          "image": "./assets/splash-transparent.png",
          "imageWidth": 1
        }
      ],
      "expo-sqlite",
      "expo-web-browser",
      "expo-secure-store",
      "@sentry/react-native"
    ],
    "extra": {
      "supabaseUrl": "https://rbiaknblwcjxexkyhgez.supabase.co",
      "supabaseAnonKey": "sb_publishable_Dj3IwqWnTtSk0Pw5wHiNDg_TNJg5gzI",
      "googleClientId": "479855671411-du26611d9a405vihccp7dqds5ndhs592.apps.googleusercontent.com",
      "googleIosClientId": "479855671411-du26611d9a405vihccp7dqds5ndhs592.apps.googleusercontent.com",
      "googleAndroidClientId": "479855671411-du26611d9a405vihccp7dqds5ndhs592.apps.googleusercontent.com",
      "sentryDsn": "SENTRY_DSN_PLACEHOLDER",
      "eas": {
        "projectId": "b57113e6-fe0f-4347-aded-f76503010c51"
      }
    }
  }
}
