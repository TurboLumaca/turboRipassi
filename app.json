{
  "expo": {
    "name": "Ripassa",
    "slug": "ripassa",
    "scheme": "ripassa",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "experiments": {
      "reactCompiler": true
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.turboLumaca.turboRipassi",
      "infoPlist": {
        "NSCameraUsageDescription": "Ripassa usa la fotocamera per allegare foto ai ripassi.",
        "NSPhotoLibraryUsageDescription": "Ripassa accede alla galleria per allegare immagini ai ripassi.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.turboLumaca.turboRipassi",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-image-picker",
      "expo-document-picker",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1E3A8A",
          "image": "./assets/splash-transparent.png",
          "imageWidth": 1
        }
      ],
      "expo-sqlite",
      "expo-web-browser",
      "expo-secure-store"
    ],
    "extra": {
      "supabaseUrl": "SUPABASE_URL_PLACEHOLDER",
      "supabaseAnonKey": "SUPABASE_ANON_KEY_PLACEHOLDER",
      "googleClientId": "GOOGLE_CLIENT_ID_PLACEHOLDER",
      "googleIosClientId": "GOOGLE_IOS_CLIENT_ID_PLACEHOLDER",
      "googleAndroidClientId": "GOOGLE_ANDROID_CLIENT_ID_PLACEHOLDER"
    }
  }
}
